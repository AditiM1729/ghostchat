# Copy to .env at the project root. Public RPC works without an API key.
# The legacy payment relay remains on testnet. Mainnet has its own deployment record.
MST_RPC_URL=https://testnetrpc.mstblockchain.com
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional frontend-only override in frontend/.env.local (browser-visible; no secret RPC keys):
# VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
# The wallet setup screen saves deployments/mst-testnet.json after verifying a real transaction.
# No signing key is required by the app or relay.
# Experienced CLI users may set MST_PRIVATE_KEY only in the deployment shell;
# never prefix it with VITE_, commit it, or send it in chat.
# Messaging uses a separate Matrix homeserver. Optional public setting in frontend/.env.local:
# VITE_MATRIX_HOMESERVER=https://matrix.your-domain.com
# MST Mainnet: deployment only (no P2P mainnet trading enabled).
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
# MST_MAINNET_PRIVATE_KEY belongs only in your deployment shell; never VITE_ or source control.

# BridgeKey account profiles: generate a random 32-byte encryption key once and back it up.
# PROFILE_ENCRYPTION_KEY=64-hex-characters-from-a-secure-random-32-byte-key
# Keep this key stable; existing encrypted profiles cannot be recovered without it.
# Matrix wallet login: same private random key in relay and Synapse jwt_config.secret.
# MATRIX_HOMESERVER=https://matrix.your-domain.com
# MATRIX_JWT_SECRET=at-least-64-random-hex-characters
# Never put MATRIX_JWT_SECRET, profile keys or payment secrets in VITE_ settings.
# The EC2 install-relay.mjs migration generates these private keys once.

# Razorpay TEST-only native tMSTC demo. Never use live keys or a funded wallet key.
# RAZORPAY_TEST_KEY_ID=rzp_test_your_public_key
# RAZORPAY_TEST_KEY_SECRET=your_test_api_secret
# RAZORPAY_TEST_WEBHOOK_SECRET=your_separate_test_webhook_secret
# TEST_PAYMENT_ATTESTOR_KEY=0x_your_dedicated_random_test_signing_key
# Generate the attestor privately with: node scripts/configure-test-payments.mjs
